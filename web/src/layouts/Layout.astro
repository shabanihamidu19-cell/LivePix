---
// Base layout for LivePix by KidCoder Tz
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "LivePix: turn your photos into video with Wan 2.2 — free",
  description = "Drop a photo, write a short prompt, get a few seconds of AI-generated video. Powered by Wan 2.2. Free, no signup. Built by KidCoder Tz.",
  ogImage = "og.png",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = Astro.site?.origin ?? "https://igorcsis.github.io";
const pagePath = Astro.url.pathname;
const canonical = new URL(pagePath, siteOrigin).toString();
const absoluteOg = new URL(`${baseUrl}${ogImage}`, siteOrigin).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LivePix",
  url: canonical,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (web)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "KidCoder Tz" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#020617" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta
      name="keywords"
      content="image to video, AI video generator, Wan 2.2, LivePix, free video AI, animate photo, image animation, KidCoder Tz"
    />
    <meta name="author" content="KidCoder Tz" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${baseUrl}og.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LivePix by KidCoder Tz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LivePix: turn photos into video with Wan 2.2" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <meta name="twitter:image:alt" content="LivePix: turn photos into video with Wan 2.2" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
