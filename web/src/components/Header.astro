---
// Top navigation for LivePix by KidCoder Tz
const baseUrl = import.meta.env.BASE_URL;
---

<header class="w-full border-b border-ink-700/60 bg-ink-900/80 backdrop-blur">
  <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    <a href={baseUrl} class="group flex items-center gap-3">
      <!-- Stylized KC mark inspired by KidCoder Tz logo -->
      <svg viewBox="0 0 40 32" class="w-9 h-7" aria-hidden="true">
        <path d="M2 6 L14 16 L2 26" fill="none" stroke="#64748B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M16 7 L22 16 L16 25" fill="none" stroke="#00E5FF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M26 8 C32 8 35 11 35 16 C35 21 32 24 26 24" fill="none" stroke="#00E5FF" stroke-width="3.2" stroke-linecap="round"/>
        <path d="M26 16 L32 16" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="text-slate-100 font-semibold tracking-tight">
        LivePix
        <span class="text-slate-500 font-normal">by KidCoder Tz</span>
      </span>
    </a>

    <nav class="flex items-center gap-4 text-sm">
      <span class="text-slate-500 text-xs">Powered by Wan 2.2</span>
    </nav>
  </div>
</header>
